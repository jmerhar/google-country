{
  "name": "google-country",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "description": "Chrome/Kiwi extension that adds a country override dropdown to Google search results (gl/cr) while keeping your language fixed (hl).",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "site": "vite build --config vite.site.config.mjs",
    "site:dev": "vite --config vite.site.config.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/chrome": "^0.0.287",
    "@vitest/coverage-v8": "^3.2.7",
    "crx3": "^1.1.3",
    "esbuild": "^0.24.0",
    "eslint": "^9.11.1",
    "globals": "^15.10.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^3.2.7"
  }
}
