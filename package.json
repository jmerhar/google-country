{
  "name": "google-country",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Chrome/Kiwi extension that adds a country override dropdown to Google search results (gl/cr) while keeping your language fixed (hl).",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "site": "vite build --config vite.site.config.mjs",
    "site:dev": "vite --config vite.site.config.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@vitest/coverage-v8": "^5.1.0",
    "crx3": "^2.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
