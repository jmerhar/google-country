# Local secrets for `make` targets that talk to the Chrome Web Store.
# Copy to `.env` (git-ignored); the Makefile auto-loads and exports these, so no manual `export`.
#
# Not needed for most targets: check / build / zip / crx / site / store-assets run without secrets,
# crx signing uses key.pem, and release upload uses your `gh` login. Only `make cws-publish` needs
# these. (CODECOV_TOKEN / COVERAGE_PAGES_TOKEN are CI-only and are not used by any make target.)

# Path to your Google Cloud service-account JSON key (keep the file git-ignored — see .gitignore).
CWS_SERVICE_ACCOUNT_KEY_FILE=secrets/cws-service-account.json

# Chrome Web Store item ID (Developer Dashboard → your item).
CWS_EXTENSION_ID=

# Publisher ID (Developer Dashboard → Account) → selects the v2 API.
CWS_PUBLISHER_ID=
